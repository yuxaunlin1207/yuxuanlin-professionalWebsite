          <div class="cover-title">Cyborg</div>
          <div>
            <div style="font-family:var(--font-display); font-style:italic; font-size:0.95rem;">for clarinet, violin and piano</div>
            <div class="cover-foot">Yuxuan Lin · 2024</div>
          </div>
          <!-- Angular/mechanical lines -->
          <svg viewBox="0 0 100 30" preserveAspectRatio="none">
            <path d="M0,20 L 15,10 L 30,20 L 45,8 L 60,22 L 75,12 L 100,18"
                  fill="none" stroke="currentColor" stroke-width="0.4"/>
          </svg>
        </div>
        <h3>Cyborg</h3>
        <div class="instr">Cl · Vln · Pno</div>
        <p style="font-size:0.95rem; color:var(--ink-soft);">Commissioned by The Juilliard School. Full score and three parts.</p>
        <div class="price-row">
          <div class="price">$40</div>
          <button class="add-btn">Add to cart</button>
        </div>
      </article>


