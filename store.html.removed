<main>

  <!-- PAGE INTRO — two-column header -->
  <section class="wrap page-intro">
    <div>
      <h1 class="display" style="font-size:clamp(2.4rem,7vw,5rem);" data-i18n="store.title">Scores</h1>
    </div>
    <p class="lead" data-i18n="store.lead">
      A small press for the catalogue. Scores are sold as high-resolution
      PDFs, individually typeset and proofread. Perusal copies on request.
    </p>
  </section>


  <section class="wrap" style="padding: 2rem 0 5rem;">

    <!-- ════════════════════════════════════════════════════════
         SCORE GRID
         .store-grid is a responsive CSS Grid that automatically
         creates columns as wide as possible, each at least 280px.
         ════════════════════════════════════════════════════════ -->
    <div class="store-grid">

      <!-- ════════════════════════════════════════════════════
           HOW TO ADD A NEW SCORE CARD
           Copy any <article class="score-card"> block (including
           all its children, down to the closing </article> tag),
           paste it above the "ADD NEW SCORES" comment, and update:

           Required attributes on <article>:
             data-id    — a unique slug, e.g. "my-new-piece"
                          (no spaces; used internally by the cart)
             data-title — the piece title as it appears in the cart
             data-price — price in USD as a number, e.g. 24

           Inside the card:
             .cover-title     — title text on the score cover
             first <div>      — instrumentation beneath the title (italic serif)
             .cover-foot      — bottom line: "Yuxuan Lin · year · YL · catalogue#"
             <h3>             — title below the cover image
             .instr           — instrumentation, duration, page count
             <p>              — one-line description
             .price           — price displayed to the user, e.g. "$24"
           ════════════════════════════════════════════════════ -->

      <!-- ─── SCORE CARD: Ternion ─────────────────────────── -->
      <article class="score-card"
               data-id="ternion"
               data-title="Ternion"
               data-price="35">
        <div class="score-cover">
          <div class="cover-title">Ternion</div>
          <div>
            <div style="font-family:var(--font-display); font-style:italic; font-size:0.95rem;">for brass trio</div>
            <div class="cover-foot">Yuxuan Lin · 2025</div>
          </div>
          <!-- Three arcs for three brass voices -->
          <svg viewBox="0 0 100 30" preserveAspectRatio="none">
            <path d="M10,25 Q 30,5 50,25"  fill="none" stroke="currentColor" stroke-width="0.4"/>
            <path d="M30,25 Q 50,5 70,25"  fill="none" stroke="currentColor" stroke-width="0.4"/>
            <path d="M50,25 Q 70,5 90,25"  fill="none" stroke="currentColor" stroke-width="0.4"/>
          </svg>
        </div>
        <h3>Ternion</h3>
        <div class="instr">Tpt · Hn · Tbn</div>
        <p style="font-size:0.95rem; color:var(--ink-soft);">Commissioned by The Juilliard School for the 2026 Lunar New Year Recital.</p>
        <div class="price-row">
          <div class="price">$35</div>
          <button class="add-btn">Add to cart</button>
        </div>
      </article>


      <!-- ─── SCORE CARD: First Pulse ──────────────────────── -->
      <article class="score-card"
               data-id="first-pulse"
               data-title="First Pulse"
               data-price="35">
        <div class="score-cover">
          <div class="cover-title">First<br/>Pulse</div>
          <div>
            <div style="font-family:var(--font-display); font-style:italic; font-size:0.95rem;">for flute and electronics</div>
            <div class="cover-foot">Yuxuan Lin · 2025</div>
          </div>
          <!-- Pulse / spike waveform -->
          <svg viewBox="0 0 100 30" preserveAspectRatio="none">
            <path d="M0,15 L 20,15 L 22,4 L 24,26 L 26,15 L 50,15 L 52,4 L 54,26 L 56,15 L 80,15 L 82,4 L 84,26 L 86,15 L 100,15"
                  fill="none" stroke="currentColor" stroke-width="0.4"/>
          </svg>
        </div>
        <h3>First Pulse</h3>
        <div class="instr">Fl · Electronics</div>
        <p style="font-size:0.95rem; color:var(--ink-soft);">Written for Robin Meiksins for the 2025 SPLICE Institute. Includes electronics setup notes.</p>
        <div class="price-row">
          <div class="price">$35</div>
          <button class="add-btn">Add to cart</button>
        </div>
      </article>


      <!-- ─── SCORE CARD: Of Drift and Pulse ───────────────── -->
      <article class="score-card"
               data-id="of-drift-and-pulse"
               data-title="Of Drift and Pulse"
               data-price="30">
        <div class="score-cover">
          <div class="cover-title">Of Drift<br/>and Pulse</div>
          <div>
            <div style="font-family:var(--font-display); font-style:italic; font-size:0.95rem;">for alto flute and guitar</div>
            <div class="cover-foot">Yuxuan Lin · 2025</div>
          </div>
          <!-- Gentle drift then pulse -->
          <svg viewBox="0 0 100 30" preserveAspectRatio="none">
            <path d="M0,15 Q 20,10 40,15 Q 55,18 60,15 L 62,5 L 64,25 L 66,15 Q 80,12 100,15"
                  fill="none" stroke="currentColor" stroke-width="0.4"/>
          </svg>
        </div>
        <h3>Of Drift and Pulse</h3>
        <div class="instr">A. Fl · Gtr</div>
        <p style="font-size:0.95rem; color:var(--ink-soft);">Written for "Who's in the Lobby" with Jessie Montgomery. Score and parts.</p>
        <div class="price-row">
          <div class="price">$30</div>
          <button class="add-btn">Add to cart</button>
        </div>
      </article>


