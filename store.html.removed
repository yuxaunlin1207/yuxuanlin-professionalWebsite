           all the text content inside. -->

    </div><!-- end .store-grid -->


    <!-- ────────────────────────────────────────────────────────
         PERUSAL & LICENSING INFO
         Two-column info block below the store grid.
         ──────────────────────────────────────────────────────── -->
    <div style="margin-top:3rem; padding-top:2rem; border-top:1px solid var(--rule);
                display:grid; grid-template-columns:1fr 1fr; gap:2rem;">
      <div>
        <h3 style="font-style:italic;" data-i18n="store.perusal.title">Perusal copies & rentals</h3>
        <p style="color:var(--ink-soft);" data-i18n="store.perusal.body">
          For programmers, conductors, and reviewers — write to request a
          watermarked perusal PDF. Large ensemble works are also available
          for rental.
        </p>
        <a href="contact.html" class="btn ghost" style="margin-top:0.5rem;" data-i18n="store.perusal.btn">
          Request a copy <span class="arrow">→</span>
        </a>
      </div>
      <div>
        <h3 style="font-style:italic;" data-i18n="store.licensing.title">Licensing</h3>
        <p style="color:var(--ink-soft);" data-i18n="store.licensing.body">
          Each purchase includes a single-performer/conductor license.
          For recordings, broadcasts, or commercial use, please
          <a href="contact.html" style="border-bottom:1px solid var(--ink);">get in touch</a>.
        </p>
      </div>
    </div>

  </section>

</main>


<!-- ══════════════════════════════════════════════════════════
     CART TOGGLE BUTTON
     Fixed to the bottom-right corner. Hidden by default;
     JavaScript adds class="visible" when the cart has items.
     The <span class="count"> shows the item count inside.
     ══════════════════════════════════════════════════════════ -->
<button id="cart-toggle" class="cart-toggle">
  Cart · <span class="count">0</span>
</button>


<!-- ══════════════════════════════════════════════════════════
     CART DRAWER
     A panel that slides in from the right side of the screen.
     JavaScript adds class="open" to slide it into view.
     aria-label tells screen readers what this element is.

     STRUCTURE:
       <h3>         — "Cart" heading + close button
       .cart-items  — dynamically filled by JavaScript
       .cart-foot   — total row + checkout button
     ══════════════════════════════════════════════════════════ -->
<aside id="cart-drawer" class="cart-drawer" aria-label="Shopping cart">

  <h3>
    <span>Cart</span>
    <!-- Close button — JavaScript listens for clicks to close the drawer -->
    <button class="close-btn" aria-label="Close cart">×</button>
  </h3>

  <!-- Cart item rows are built and injected here by JavaScript.
       Initially empty; filled when items are added. -->
  <div class="cart-items"></div>

  <!-- Footer: total price and checkout button -->
  <div class="cart-foot">
    <!-- "Total" label on the left, "$0.00" updated by JavaScript on the right -->
    <div class="cart-total">
      <span>Total</span>
      <span>$0.00</span>
    </div>

    <!-- CHECKOUT BUTTON
         Currently shows a demo alert with the cart contents.
         To enable real payment: see README.md → "Store / cart" section.
         style="width:100%" makes it span the full drawer width. -->
    <button class="btn checkout-btn" style="width:100%;">
      Checkout <span class="arrow">→</span>
    </button>

    <p class="subtle" style="margin-top:0.8rem; line-height:1.5;">
      All scores delivered as PDF download. Includes single-performer/conductor license.
    </p>
  </div>

</aside>

<!-- Dark overlay behind the cart drawer.
     JavaScript adds class="visible" when the drawer is open.
     Clicking the overlay also closes the drawer (wired in main.js). -->
<div id="cart-overlay" class="overlay"></div>


<!-- SITE FOOTER — identical on every page -->
<footer class="site-footer">
  <div class="wrap footer-inner">
    <div>© Yuxuan Lin, 2026</div>
    <div><a href="contact.html" data-i18n="footer.contact">Contact</a> · <a href="store.html" data-i18n="footer.scores">Scores</a> · <a href="#" data-i18n="footer.newsletter">Newsletter</a></div>
  </div>
</footer>

<script src="i18n.js"></script>
<script src="main.js"></script>
</body>
</html>
